# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_openai_api_key_here' with your actual OpenAI API key
# 3. Never commit .env to version control

# Optional: comma-separated browser origins allowed to call /api/chatbot.
# Unset = https://jovylle.com, https://www.jovylle.com, http://localhost:3000, http://localhost:3001,
#         http://localhost:3999, http://127.0.0.1:3000, http://127.0.0.1:3999.
# Setting it REPLACES the default list, so include jovylle.com yourself.
# Third-party sites that embed the widget must be listed here.
# CHATBOT_ALLOWED_ORIGINS=https://jovylle.com,https://www.jovylle.com,http://localhost:3000
